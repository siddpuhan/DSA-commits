#include<iostream>
using namespace std;
int main(){
    int n;
    cin>>n;
    int revnum =0;
    int dup = n;
    while(n>0){
        int ldig = n%10;
        revnum=(revnum * 10 )+ ldig;
        n=n/10;

    }
    if(dup==revnum){
        cout<<"it is palindrome";
    }
    else{
        cout<<"not a palindrome";
    }

}

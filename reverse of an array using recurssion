#include<bits/stdc++.h>
using namespace std;
void reverseArray(int arr[], int start, int end){
    if(start>=end){
        return;

    }
    swap(arr[start],arr[end]);
    reverseArray(arr,start+1,end-1);

}

int main(){
    int arr [] = {7,8,9,3,2};
    
    reverseArray(arr,0,4);
    for(int i = 0; i<5; i++){
        cout<<arr[i]<<" ";
    }

}

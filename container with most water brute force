class Solution {
public:
    int maxArea(vector<int>& height) {
        int n = height.size();
        int maxarea=0;
        for(int i=0 ; i<n ; i++){
            for(int j=i+1; j<n; j++){
                int width = j-i;
                int area = width * min(height[i],height[j]);
                maxarea=max(maxarea,area);
            }

        }
        return maxarea;
        


        
    }
};

#include <iostream>
#include <cmath>
using namespace std;

int main() {
    int n;
    cin >> n;

    int dup = n;
    int original = n;

    int calc = 0;
    int count = 0;

    // Count digits
    while (n > 0) {
        count++;
        n = n / 10;
    }

    // Calculate Armstrong sum
    while (dup > 0) {
        int ldig = dup % 10;

        calc = calc + (int)pow(ldig, count);

        dup = dup / 10;
    }

    cout << "calc = " << calc << endl;

    if (calc == original) {
        cout << "it is armstrong";
    }
    else {
        cout << "not armstrong";
    }
}
